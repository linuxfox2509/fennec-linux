---
modules-search:
  - local
  - /usr/lib/calamares/modules

oem-setup: false
disable-cancel: false
disable-cancel-during-exec: false
quit-at-end: false

instances:
  - id: desktopchooser
    module: packagechooser
    config: desktopchooser.conf

  - id: resolverprepare
    module: shellprocess
    config: resolverprepare.conf

  - id: desktopinstall
    module: contextualprocess
    config: desktopinstall.conf

  - id: resolverrestore
    module: shellprocess
    config: resolverrestore.conf

sequence:
  - show:
      - welcome
      - locale
      - keyboard
      - packagechooser@desktopchooser
      - partition
      - users
      - summary

  - exec:
      - partition
      - mount
      - unpackfs
      - luksbootkeyfile
      - dpkg-unsafe-io
      - sources-media
      - machineid
      - fstab
      - locale
      - keyboard
      - localecfg
      - users
      - networkcfg
      - hwclock
      - services-systemd
      - bootloader-config
      - grubcfg
      - bootloader

      - shellprocess@resolverprepare
      - sources-media-unmount
      - sources-final

      - contextualprocess@desktopinstall
      - displaymanager

      - packages
      - plymouthcfg
      - initramfscfg
      - initramfs
      - dpkg-unsafe-io-undo

      - shellprocess@resolverrestore
      - umount

  - show:
      - finished

branding: fennec
prompt-install: false
dont-chroot: false
