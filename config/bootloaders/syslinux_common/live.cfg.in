label live-@FLAVOUR@
        menu label ^Fennec Linux Live
        menu default
        linux @LINUX@
        initrd @INITRD@
        append @APPEND_LIVE@

label live-@FLAVOUR@-failsafe
        menu label Fennec Linux Live (failsafe)
        linux @LINUX@
        initrd @INITRD@
        append @APPEND_LIVE_FAILSAFE@
